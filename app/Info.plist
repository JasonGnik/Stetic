<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key>            <string>$(PRODUCT_NAME)</string>
  <key>CFBundleDisplayName</key>     <string>Stetic</string>
  <key>CFBundleIdentifier</key>      <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
  <key>CFBundleExecutable</key>      <string>$(EXECUTABLE_NAME)</string>
  <key>CFBundlePackageType</key>     <string>APPL</string>
  <key>CFBundleShortVersionString</key> <string>$(MARKETING_VERSION)</string>
  <key>CFBundleVersion</key>         <string>$(CURRENT_PROJECT_VERSION)</string>
  <key>LSRequiresIPhoneOS</key>      <true/>
  <!-- App uses only standard HTTPS (exempt) encryption — skips the export-compliance prompt each upload. -->
  <key>ITSAppUsesNonExemptEncryption</key> <false/>
  <key>UILaunchScreen</key>          <dict/>
  <key>UISupportedInterfaceOrientations</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
  </array>
  <!-- OAuth callback (Google sign-in via Supabase) -->
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>     <string>com.stetic.app.oauth</string>
      <key>CFBundleURLSchemes</key>
      <array><string>stetic</string></array>
    </dict>
  </array>
  <key>NSPhotoLibraryUsageDescription</key>
  <string>Stetic uses your photos to scan and score your physique.</string>
  <key>NSCameraUsageDescription</key>
  <string>Stetic uses the camera to scan your physique.</string>
  <key>NSHealthShareUsageDescription</key>
  <string>Stetic reads your steps and bodyweight to track activity and progress.</string>
  <key>NSHealthUpdateUsageDescription</key>
  <string>Stetic saves the bodyweight you log to Apple Health.</string>
  <!-- DEV ONLY: allow http to the local Supabase stack on 127.0.0.1 -->
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsLocalNetworking</key>
    <true/>
  </dict>
</dict>
</plist>
